---
// 🖼️ AUTO-LOADING LV GALLERY — WITH LABELS ON MAIN PHOTOS
//
// HOW IT WORKS:
//   Every photo inside public/images/LV/ is loaded automatically at build
//   time. You NEVER need to edit this file to add photos — just drop new
//   JPGs into the LV folder and push to GitHub.
//
// LABELS:
//   Main photos (lv1, lv2, lv3, ...) get a caption showing their number.
//   Detail photos (lv1.1, lv1.2, lv2.1, ...) are shown WITHOUT a caption.
//
// TO ADD ANOTHER BRAND:
//   1. Create a folder in public/images/ (e.g. public/images/gucci/)
//   2. Drop photos in it
//   3. Add the brand name to the `brands` list below and add a matching
//      block after the LV block (copy the pattern).

import fs from "node:fs";
import path from "node:path";

const brands = ["All", "LV"];

const imagesRoot = path.join(process.cwd(), "public", "images");
const brandDirs = fs.existsSync(imagesRoot)
  ? fs.readdirSync(imagesRoot, { withFileTypes: true })
  : [];
const lvDir = brandDirs.find((d) => d.isDirectory() && /^lv$/i.test(d.name));

const files = lvDir
  ? fs
      .readdirSync(path.join(imagesRoot, lvDir.name))
      .filter((f) => /\.(jpe?g|png|webp|gif)$/i.test(f))
  : [];

// Natural sort: lv1, lv1.1, lv1.2, lv2, lv2.1, ... lv10, ...
files.sort((a, b) => {
  const nums = (s) => (s.match(/\d+(\.\d+)?/g) || []).map(Number);
  const na = nums(a);
  const nb = nums(b);
  for (let i = 0; i < Math.max(na.length, nb.length); i++) {
    const da = na[i] ?? -1;
    const db = nb[i] ?? -1;
    if (da !== db) return da - db;
  }
  return a.localeCompare(b);
});

const images = files.map((f) => {
  const stem = f.replace(/\.(jpe?g|png|webp|gif)$/i, "");
  const numPart = (stem.match(/\d+(\.\d+)?/) || [""])[0];
  // Main photo = number has no decimal (lv1, lv2, ...). Detail = has decimal.
  const isMain = numPart !== "" && !numPart.includes(".");
  return {
    src: `/images/${lvDir.name}/${f}`,
    alt: stem,
    brand: "LV",
    label: isMain ? `LV ${numPart}` : null,
  };
});
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>My Gallery</title>
    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      body {
        font-family: system-ui, -apple-system, sans-serif;
        background: #0f1115;
        color: #e6e6e6;
        padding: 2rem 1rem;
      }
      h1 {
        text-align: center;
        margin-bottom: 1.5rem;
        font-size: 2rem;
      }
      .buttons {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.5rem;
        margin-bottom: 2rem;
      }
      .brand-btn {
        background: #1a1d24;
        color: #e6e6e6;
        border: 1px solid #333;
        padding: 0.5rem 1.25rem;
        border-radius: 999px;
        cursor: pointer;
        font-size: 1rem;
      }
      .brand-btn:hover {
        border-color: #f6821f;
      }
      .brand-btn.active {
        background: #f6821f;
        border-color: #f6821f;
        color: #0f1115;
        font-weight: 600;
      }
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 1rem;
        max-width: 1100px;
        margin: 0 auto;
      }
      figure {
        margin: 0;
        overflow: hidden;
        border-radius: 12px;
        background: #1a1d24;
        position: relative;
      }
      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        aspect-ratio: 4 / 3;
        display: block;
        transition: transform 0.3s ease;
      }
      figure:hover img {
        transform: scale(1.05);
      }
      figcaption {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        background: rgba(0, 0, 0, 0.65);
        color: #fff;
        padding: 0.4rem 0.75rem;
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 0.02em;
      }
    </style>
  </head>
  <body>
    <h1>My Gallery</h1>

    <div class="buttons">
      {
        brands.map((brand) => (
          <button
            class:list={["brand-btn", { active: brand === "All" }]}
            data-brand={brand}
          >
            {brand}
          </button>
        ))
      }
    </div>

    <div class="grid">
      {
        images.map((img) => (
          <figure data-brand={img.brand}>
            <img src={img.src} alt={img.alt} loading="lazy" />
            {img.label && <figcaption>{img.label}</figcaption>}
          </figure>
        ))
      }
    </div>

    <script>
      const buttons = document.querySelectorAll(".brand-btn");
      const figures = document.querySelectorAll("figure");

      buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const brand = btn.dataset.brand;
          figures.forEach((fig) => {
            const show = brand === "All" || fig.dataset.brand === brand;
            fig.style.display = show ? "" : "none";
          });
          buttons.forEach((b) => b.classList.toggle("active", b === btn));
        });
      });
    </script>
  </body>
</html>