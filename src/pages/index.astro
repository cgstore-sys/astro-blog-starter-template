---
// 🖼️ BRAND-FILTERED IMAGE GALLERY
//
// HOW TO ADD A BRAND:
//   1. Create a folder inside public/images/ named after the brand,
//      e.g. public/images/lv/
//   2. Drop that brand's photos into the folder (photo1.jpg, photo2.jpg, ...)
//   3. Add the brand name to the `brands` list below
//   4. Add one line per photo to the `images` list, like:
//      { src: "/images/lv/photo1.jpg", alt: "LV product", brand: "LV" }
//   5. Push to GitHub — Cloudflare rebuilds automatically.

const brands = ["All", "LV"];

const images = [
  { src: "/images/lv/photo1.jpg", alt: "LV photo 1", brand: "LV" },
  { src: "/images/lv/photo2.jpg", alt: "LV photo 2", brand: "LV" },
  { src: "/images/lv/photo3.jpg", alt: "LV photo 3", brand: "LV" },
  { src: "/images/lv/photo4.jpg", alt: "LV photo 4", brand: "LV" },
  { src: "/images/lv/photo5.jpg", alt: "LV photo 5", brand: "LV" },
  { src: "/images/lv/photo6.jpg", alt: "LV photo 6", brand: "LV" },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>My Gallery</title>
    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      body {
        font-family: system-ui, -apple-system, sans-serif;
        background: #0f1115;
        color: #e6e6e6;
        padding: 2rem 1rem;
      }
      h1 {
        text-align: center;
        margin-bottom: 1.5rem;
        font-size: 2rem;
      }
      .buttons {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.5rem;
        margin-bottom: 2rem;
      }
      .brand-btn {
        background: #1a1d24;
        color: #e6e6e6;
        border: 1px solid #333;
        padding: 0.5rem 1.25rem;
        border-radius: 999px;
        cursor: pointer;
        font-size: 1rem;
      }
      .brand-btn:hover {
        border-color: #f6821f;
      }
      .brand-btn.active {
        background: #f6821f;
        border-color: #f6821f;
        color: #0f1115;
        font-weight: 600;
      }
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 1rem;
        max-width: 1100px;
        margin: 0 auto;
      }
      figure {
        margin: 0;
        overflow: hidden;
        border-radius: 12px;
        background: #1a1d24;
      }
      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        aspect-ratio: 4 / 3;
        display: block;
        transition: transform 0.3s ease;
      }
      figure:hover img {
        transform: scale(1.05);
      }
    </style>
  </head>
  <body>
    <h1>My Gallery</h1>

    <div class="buttons">
      {
        brands.map((brand) => (
          <button
            class:list={["brand-btn", { active: brand === "All" }]}
            data-brand={brand}
          >
            {brand}
          </button>
        ))
      }
    </div>

    <div class="grid">
      {
        images.map((img) => (
          <figure data-brand={img.brand}>
            <img src={img.src} alt={img.alt} loading="lazy" />
          </figure>
        ))
      }
    </div>

    <script>
      const buttons = document.querySelectorAll(".brand-btn");
      const figures = document.querySelectorAll("figure");

      buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const brand = btn.dataset.brand;
          figures.forEach((fig) => {
            const show = brand === "All" || fig.dataset.brand === brand;
            fig.style.display = show ? "" : "none";
          });
          buttons.forEach((b) => b.classList.toggle("active", b === btn));
        });
      });
    </script>
  </body>
</html>